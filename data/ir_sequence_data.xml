<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for Loan Requests -->
        <record id="sequence_hr_loan" model="ir.sequence">
            <field name="name">Employee Loan Request Sequence</field>
            <field name="code">hr.loan</field>
            <field name="prefix">LOAN/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Advance Salary Approval Category -->
        <record id="sequence_approval_advance_salary" model="ir.sequence">
            <field name="name">Employee Loan - Advance Salary Approval Sequence</field>
            <field name="code">approval.category.advance_salary</field>
            <field name="prefix">LOAN-ADV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for High Monetary Amount Approval Category -->
        <record id="sequence_approval_high_amount" model="ir.sequence">
            <field name="name">Employee Loan - High Monetary Amount Approval Sequence</field>
            <field name="code">approval.category.high_amount</field>
            <field name="prefix">LOAN-HIGH/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
