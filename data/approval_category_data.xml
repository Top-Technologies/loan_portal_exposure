        <!-- 1. Approval Category: Advance One Month Salary Loan (General) -->
        <record id="approval_category_advance_salary_loan" model="approval.category">
            <field name="name">Employee Loan - Advance 1-Month Salary (General)</field>
            <field name="has_amount">optional</field>
            <field name="has_date">optional</field>
            <field name="has_reference">optional</field>
            <field name="approval_minimum">1</field>
            <field name="manager_approval" eval="False"/>
            <field name="loan_category_type">advance_salary</field>
            <field name="employee_classification">all</field>
            <field name="sequence_code">LOAN-ADV</field>
            <field name="automated_sequence">True</field>
            <field name="sequence_id" ref="sequence_approval_advance_salary"/>
            <field name="description">Approval category for employee advance one month salary loans (all classifications fallback).</field>
