<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-Company Rule for hr.loan -->
        <record id="hr_loan_company_rule" model="ir.rule">
            <field name="name">Employee Loan: Multi-Company</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Portal Employee: Access Own Loans -->
        <record id="hr_loan_portal_employee_rule" model="ir.rule">
            <field name="name">Portal Employee: Own Loan Requests</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal Farm Manager: Access Farm Workers Loans -->
        <record id="hr_loan_portal_farm_manager_rule" model="ir.rule">
            <field name="name">Portal Farm Manager: Farm Employee Loans</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[
                '|',
                ('farm_id.manager_id.user_id', '=', user.id),
                ('farm_manager_id.user_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Internal Users: Full Access within Company -->
        <record id="hr_loan_internal_user_rule" model="ir.rule">
            <field name="name">Internal Users: All Company Loans</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
