<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Smart Buttons & Loans Tab on Employee Form -->
    <record id="view_employee_form_inherit_loan_portal" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.loan.portal</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">45</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_employee_loans" type="object" class="oe_stat_button" icon="fa-money" groups="hr.group_hr_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="loan_count"/>
                        </span>
                        <span class="o_stat_text">Loans</span>
                    </div>
                </button>
                <button name="action_view_employee_attachments" type="object" class="oe_stat_button" icon="fa-paperclip" groups="hr.group_hr_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="active_attachments_count"/>
                        </span>
                        <span class="o_stat_text">Attachments</span>
                    </div>
                </button>
            </xpath>

            <!-- Dedicated Tab for Loans & Attachments Overview & Resignation Clearance -->
            <xpath expr="//notebook" position="inside">
                <page string="Loans &amp; Attachments" name="loans_attachments" groups="hr.group_hr_user">
                    <field name="has_outstanding_liabilities" invisible="1"/>
                    <field name="outstanding_loan_balance" invisible="1"/>
                    <field name="outstanding_attachment_balance" invisible="1"/>
                    <field name="total_outstanding_liability" invisible="1"/>

                    <!-- Offboarding & Financial Clearance KPI Banner -->
                    <div invisible="not has_outstanding_liabilities"
                         style="background-color: #ffffff !important; border: 2px solid #dc2626 !important; border-radius: 8px; padding: 14px; margin-bottom: 16px; box-shadow: 0 4px 6px -1px rgba(220, 38, 38, 0.1);">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle p-2 d-flex align-items-center justify-content-center"
                                     style="width: 44px; height: 44px; background-color: #fee2e2 !important; border: 1.5px solid #dc2626 !important;">
                                    <i class="fa fa-exclamation-triangle fa-lg" style="color: #dc2626 !important;"/>
                                </div>
                                <div>
                                    <div class="fw-bolder fs-6" style="color: #991b1b !important;">
                                        Active Financial Liabilities (Clearance Alert)
                                    </div>
                                    <div style="color: #475569 !important; font-size: 0.88rem;">
                                        Outstanding Loans: <strong style="color: #0369a1 !important;"><field name="outstanding_loan_balance" widget="monetary"/></strong> 
                                        &#160;|&#160; Open Attachments: <strong style="color: #b45309 !important;"><field name="outstanding_attachment_balance" widget="monetary"/></strong>
                                    </div>
                                </div>
                            </div>
                            <div class="text-end px-3 py-2 rounded" style="background-color: #fef2f2 !important; border: 1.5px solid #dc2626 !important;">
                                <div style="color: #991b1b !important; font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">Total Unsettled Liability</div>
                                <div class="fs-5 fw-bolder" style="color: #7f1d1d !important;">
                                    <field name="total_outstanding_liability" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 1. Employee Loans -->
                    <div class="card mb-4 border rounded-3">
                        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark"><i class="fa fa-money text-primary me-2"/>Employee Loans</span>
                            <span class="badge bg-primary"><field name="loan_count"/> Total</span>
                        </div>
                        <div class="card-body p-0">
                            <field name="loan_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="loan_type"/>
                                    <field name="loan_amount" widget="monetary"/>
                                    <field name="installment_amount" widget="monetary"/>
                                    <field name="installment_months"/>
                                    <field name="state" widget="badge" 
                                           decoration-success="state == 'approved'" 
                                           decoration-warning="state in ('submitted', 'farm_approved', 'gm_pending')" 
                                           decoration-danger="state == 'rejected'"/>
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- 2. Salary Attachments -->
                    <div class="card border rounded-3">
                        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark"><i class="fa fa-paperclip text-primary me-2"/>Salary Attachments &amp; Bank Loans</span>
                            <span class="badge bg-secondary"><field name="active_attachments_count"/> Open</span>
                        </div>
                        <div class="card-body p-0">
                            <field name="salary_attachment_ids" readonly="1">
                                <list>
                                    <field name="description"/>
                                    <field name="loan_deduction_type"/>
                                    <field name="total_amount" widget="monetary"/>
                                    <field name="paid_amount" widget="monetary"/>
                                    <field name="remaining_amount" widget="monetary"/>
                                    <field name="monthly_amount" widget="monetary"/>
                                    <field name="date_start"/>
                                    <field name="state" widget="badge" 
                                           decoration-info="state == 'open'" 
                                           decoration-success="state == 'close'" 
                                           decoration-muted="state == 'cancel'"/>
                                </list>
                            </field>
                        </div>
                    </div>

                </page>
            </xpath>
        </field>
    </record>

</odoo>
