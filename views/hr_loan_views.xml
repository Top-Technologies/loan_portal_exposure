<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Loan Form View -->
    <record id="view_hr_loan_form" model="ir.ui.view">
        <field name="name">hr.loan.form</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <form string="Employee Loan Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    
                    <button name="action_portal_farm_manager_approve" string="Farm Manager Approve" type="object" class="oe_highlight" invisible="state != 'waiting_farm_manager'"/>
                    <button name="action_portal_gm_approve" string="GM Approve" type="object" class="oe_highlight" invisible="state != 'waiting_gm'"/>
                    
                    <button name="action_portal_reject" string="Reject" type="object" class="btn-danger" invisible="state not in ('waiting_farm_manager', 'waiting_gm')"/>
                    <button name="action_portal_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'waiting_farm_manager', 'waiting_gm')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting_farm_manager,waiting_gm,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_salary_attachment"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-paperclip"
                                invisible="not salary_attachment_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Salary Attachment</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="employee_info" string="Employee &amp; Farm">
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                            <field name="farm_id" readonly="1"/>
                            <field name="farm_manager_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_portal_submitted" readonly="1"/>
                        </group>
                        <group name="loan_details" string="Loan Parameters">
                            <field name="loan_type" widget="radio"/>
                            <field name="loan_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_date"/>
                            <field name="installment_months" readonly="loan_type == 'advance_salary'"/>
                            <field name="installment_amount" widget="monetary"/>
                            <field name="approval_request_id" readonly="1" invisible="not approval_request_id"/>
                            <field name="salary_attachment_id" readonly="1" invisible="not salary_attachment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="reason_page" string="Reason &amp; Purpose">
                            <field name="reason" placeholder="Enter loan justification..."/>
                        </page>
                        <page name="approval_page" string="Approval Details">
                            <group>
                                <group>
                                    <field name="approved_by_id" readonly="1" invisible="not approved_by_id"/>
                                    <field name="approval_date" readonly="1" invisible="not approval_date"/>
                                </group>
                                <group>
                                    <field name="rejection_reason" readonly="1" invisible="not rejection_reason"/>
                                </group>
                            </group>
                        </page>
                        <page name="attachments_page" string="Supporting Documents">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Loan Tree / List View -->
    <record id="view_hr_loan_tree" model="ir.ui.view">
        <field name="name">hr.loan.list</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <list string="Employee Loans" decoration-info="state in ('waiting_farm_manager', 'waiting_gm')" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="loan_type"/>
                <field name="loan_amount" sum="Total Loans"/>
                <field name="installment_months"/>
                <field name="installment_amount"/>
                <field name="payment_date"/>
                <field name="farm_id"/>
                <field name="state" widget="badge" decoration-info="state in ('waiting_farm_manager', 'waiting_gm')" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Loan Search View -->
    <record id="view_hr_loan_search" model="ir.ui.view">
        <field name="name">hr.loan.search</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <search string="Search Loans">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="farm_id"/>
                <filter name="pending" string="Pending Approvals" domain="[('state', 'in', ['waiting_farm_manager', 'waiting_gm'])]"/>
                <filter name="advance_salary" string="Advance Salary Loans" domain="[('loan_type', '=', 'advance_salary')]"/>
                <filter name="high_amount" string="High Amount Loans" domain="[('loan_type', '=', 'high_amount')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Farm" name="group_farm" context="{'group_by': 'farm_id'}"/>
                    <filter string="Category" name="group_type" context="{'group_by': 'loan_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Loan Window Action -->
    <record id="action_hr_loan" model="ir.actions.act_window">
        <field name="name">Employee Loans</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_loan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Employee Loan request
            </p>
            <p>
                Manage advance salary loans and high monetary amount loans submitted via portal or backend.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_hr_loan_root"
              name="Loans"
              parent="hr.menu_hr_root"
              sequence="25"
              action="action_hr_loan"/>

</odoo>
