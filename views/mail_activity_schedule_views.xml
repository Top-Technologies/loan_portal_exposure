<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_activity_schedule_view_form_inherit_loans" model="ir.ui.view">
        <field name="name">mail.activity.schedule.view.form.inherit.loans</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="has_outstanding_liabilities" invisible="1"/>
                <field name="currency_id" invisible="1"/>
            </xpath>
            <xpath expr="//form/*[1]" position="before">
                <!-- High-Contrast Clearance & Financial Liability Warning for Offboarding / Onboarding Plans -->
                <div invisible="not has_outstanding_liabilities"
                     style="background-color: #ffffff !important; border: 2px solid #dc2626 !important; border-radius: 8px; padding: 12px; margin-bottom: 16px; box-shadow: 0 4px 6px -1px rgba(220, 38, 38, 0.1);">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fa fa-exclamation-triangle fa-2x" style="color: #dc2626 !important;"/>
                        <div>
                            <div class="fw-bolder fs-6" style="color: #991b1b !important;">
                                Outstanding Financial Liabilities Detected
                            </div>
                            <div style="color: #475569 !important; font-size: 0.85rem;">
                                This employee has active loans or open salary attachments that must be settled during offboarding / clearance.
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 text-center mt-2 pt-2" style="border-top: 1px solid #fecaca !important;">
                        <div class="col-4">
                            <div class="p-2 rounded" style="background-color: #f0f9ff !important; border: 1.5px solid #0284c7 !important;">
                                <div style="color: #0369a1 !important; font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">
                                    Active Loans Balance
                                </div>
                                <div class="fs-6 fw-bolder mt-1" style="color: #0c4a6e !important;">
                                    <field name="outstanding_loan_balance" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 rounded" style="background-color: #fffbeb !important; border: 1.5px solid #d97706 !important;">
                                <div style="color: #b45309 !important; font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">
                                    Open Attachments
                                </div>
                                <div class="fs-6 fw-bolder mt-1" style="color: #78350f !important;">
                                    <field name="outstanding_attachment_balance" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 rounded" style="background-color: #fef2f2 !important; border: 2px solid #dc2626 !important;">
                                <div style="color: #991b1b !important; font-size: 0.78rem; font-weight: 800; text-transform: uppercase;">
                                    Total Unsettled Liability
                                </div>
                                <div class="fs-5 fw-bolder mt-1" style="color: #7f1d1d !important;">
                                    <field name="total_outstanding_liability" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
